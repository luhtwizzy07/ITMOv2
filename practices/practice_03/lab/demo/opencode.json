{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "local-guide",
  "enabled_providers": [
    "ollama"
  ],
  "model": "ollama/itmo-agent",
  "small_model": "ollama/itmo-agent",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama local",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "itmo-agent": {
          "name": "ITMO local 64k",
          "options": {
            "temperature": 0.2,
            "reasoningEffort": "none"
          },
          "limit": {
            "context": 65536,
            "output": 4096
          }
        }
      }
    }
  },
  "agent": {
    "local-guide": {
      "description": "Read-only local repository assistant",
      "mode": "primary",
      "prompt": "{file:./repo-system.txt}",
      "steps": 8,
      "permission": {
        "*": "deny",
        "read": {
          "*": "deny",
          "**/README.md": "allow",
          "**/Makefile": "allow",
          "**/service.py": "allow",
          "**/test_service.py": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "external_directory": "deny"
      }
    }
  }
}
