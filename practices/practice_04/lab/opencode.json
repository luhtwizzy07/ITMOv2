{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/itmo-agent",
  "small_model": "ollama/itmo-agent",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama local",
      "options": {"baseURL": "http://localhost:11434/v1"},
      "models": {
        "itmo-agent": {
          "name": "ITMO local 64k",
          "limit": {"context": 65536, "output": 4096}
        }
      }
    }
  },
  "mcp": {
    "notify_checks": {
      "type": "local",
      "command": [".venv/bin/python", "mcp_server.py"],
      "enabled": true,
      "timeout": 10000
    }
  },
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "skill": "allow",
    "notify_checks_*": "allow",
    "edit": "allow",
    "bash": {"*": "ask", "sh scripts/check.sh*": "allow", "python3 .opencode/skills/notify-tdd/scripts/phase.py*": "allow", "git diff*": "allow", "git status*": "allow", "pwd": "allow"},
    "task": "allow"
  }
}
